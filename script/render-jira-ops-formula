#!/usr/bin/env bash
set -euo pipefail

version=$1
dist_dir=$2
output=$3

if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
  echo "invalid release version: $version" >&2
  exit 2
fi

read_digest() {
  local target=$1
  local archive="jira-ops-v$version-$target.tar.gz"
  local sidecar="$dist_dir/$archive.sha256"
  local digest filename

  [[ -f "$dist_dir/$archive" ]] || {
    echo "missing release archive: $archive" >&2
    return 1
  }
  [[ -f "$sidecar" ]] || {
    echo "missing release checksum: $archive.sha256" >&2
    return 1
  }
  read -r digest filename < "$sidecar"
  if [[ ! "$digest" =~ ^[0-9a-f]{64}$ ]] || [[ "$filename" != "$archive" ]]; then
    echo "invalid release checksum: $archive.sha256" >&2
    return 1
  fi

  printf '%s' "$digest"
}

mac_arm_sha=$(read_digest aarch64-apple-darwin)
mac_intel_sha=$(read_digest x86_64-apple-darwin)
linux_arm_sha=$(read_digest aarch64-unknown-linux-gnu)
linux_intel_sha=$(read_digest x86_64-unknown-linux-gnu)

temporary=$(mktemp "${output}.tmp.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT

cat > "$temporary" <<FORMULA
class JiraOps < Formula
  desc "Predictable, agent-friendly CLI for Jira Cloud"
  homepage "https://github.com/amaljithkuttamath/jira-ops"
  version "$version"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/amaljithkuttamath/jira-ops/releases/download/v$version/jira-ops-v$version-aarch64-apple-darwin.tar.gz"
      sha256 "$mac_arm_sha"
    else
      url "https://github.com/amaljithkuttamath/jira-ops/releases/download/v$version/jira-ops-v$version-x86_64-apple-darwin.tar.gz"
      sha256 "$mac_intel_sha"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/amaljithkuttamath/jira-ops/releases/download/v$version/jira-ops-v$version-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "$linux_arm_sha"
    else
      url "https://github.com/amaljithkuttamath/jira-ops/releases/download/v$version/jira-ops-v$version-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "$linux_intel_sha"
    end
  end

  def install
    bin.install "jira-ops"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/jira-ops version")
  end
end
FORMULA

chmod 0644 "$temporary"
mv -- "$temporary" "$output"
trap - EXIT
